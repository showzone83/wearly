{
  "realm": "wearly",
  "displayName": "Wearly 로컬 SSO 시험",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "groups": [
    {
      "name": "wearly-admins",
      "path": "/wearly-admins",
      "attributes": {
        "description": [
          "Wearly 관리자 사이트 전체 권한 (wearly.sso.providers.keycloak.admin-groups)"
        ]
      }
    },
    {
      "name": "wearly-viewers",
      "path": "/wearly-viewers",
      "attributes": {
        "description": [
          "조회만 (지금은 관리자 사이트에 들어갈 수 없음: SSO_NOT_ADMIN)"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "wearly-admin",
      "name": "Wearly 관리자 사이트",
      "description": "백엔드가 Authorization Code + PKCE(S256)로 로그인을 받는다 (doc/22 4.2)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "wearly-admin-local-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:8080/api/v1/auth/sso/keycloak/callback",
        "http://localhost:18080/api/v1/auth/sso/keycloak/callback",
        "http://localhost:18081/api/v1/auth/sso/keycloak/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/login",
        "frontchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@wearly.local",
      "email": "admin@wearly.local",
      "emailVerified": true,
      "firstName": "시험",
      "lastName": "관리자",
      "enabled": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "WearlyAdmin1!",
          "temporary": false
        }
      ],
      "groups": [
        "/wearly-admins"
      ]
    },
    {
      "username": "viewer@wearly.local",
      "email": "viewer@wearly.local",
      "emailVerified": true,
      "firstName": "시험",
      "lastName": "조회자",
      "enabled": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "WearlyViewer1!",
          "temporary": false
        }
      ],
      "groups": [
        "/wearly-viewers"
      ]
    }
  ]
}
