# backend/.env로 복사해서 쓴다 (.env는 git에 올리지 않는다)
# 값을 비워 두면 application.yml의 기본값을 쓴다.

# --- AI 공급자 키 ---
# 어떤 공급자를 어떤 순서로 쓸지는 관리자 사이트(AI 공급자)에서 정한다 (DB tb_ai_provider).
# 키는 두 가지로 넣을 수 있다: (1) 여기 환경변수 — 공급자 행의 api_key_env가 아래 이름을 가리킨다
# (2) 관리자 사이트에서 웹 입력 — 아래 WEARLY_SECRET_KEY가 있어야 하고, 넣으면 (1)보다 먼저 쓴다.
# 처음 상태: claude(사용, claude-opus-5-5) · openai(꺼짐, 모델 없음) · gemini(꺼짐, 모델 없음)
# 쓸 수 있는 공급자가 하나도 없으면 서버는 뜨지만 사진 분석·AI 코디 추천은 502가 된다. 키 없이 보려면 ./gradlew bootRunMock
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- 웹 입력 AI 키의 마스터 키 (07 문서 6장) ---
# 관리자 화면에서 넣은 AI 키를 AES-256-GCM으로 암호화하는 키. base64로 인코딩한 32바이트. DB에는 저장하지 않는다.
# 만들기:  openssl rand -base64 32
# 비워 두면 웹 키 입력이 꺼진다 (저장 API 409 SECRET_KEY_MISSING, 환경변수 키는 그대로 씀).
# 이 값을 바꾸거나 잃어버리면 이미 넣은 웹 키는 복호화되지 않는다 → 관리자 화면에서 다시 넣어야 한다.
WEARLY_SECRET_KEY=

# --- 관리자 계정 ---
# 둘 다 있으면 서버 시작 시 이 계정을 만들거나 기존 계정을 ADMIN으로 올린다 (기존 계정의 비밀번호는 바꾸지 않음)
WEARLY_ADMIN_EMAIL=
WEARLY_ADMIN_PASSWORD=
# WEARLY_ADMIN_NAME=관리자

# JWT 서명 키 (HS256, 32바이트 이상). 운영(prod 프로필)에서는 필수
WEARLY_JWT_SECRET=

# 선택 항목
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/wearly
# SPRING_DATASOURCE_USERNAME=wearly
# SPRING_DATASOURCE_PASSWORD=wearly
# SERVER_PORT=8080
# WEARLY_ACCESS_TTL=PT30M
# WEARLY_REFRESH_TTL=P30D
# AI 실행 방식: db(기본, 관리자 화면 설정) | mock. 여기에 mock을 적으면 bootRun도 목업이 되니 보통은 두지 않는다
# WEARLY_AI_PROVIDER=db
# 회원별 하루 사진 분석 횟수 (성공만)
# WEARLY_AI_DAILY_LIMIT=10
# 회원별 하루 AI 코디 추천 횟수 (사진 분석과 따로, 성공만 센다. 09 문서)
# WEARLY_AI_OUTFIT_DAILY_LIMIT=20
# 공급자 호출 제한 시간 기본값 (공급자 options.timeoutSeconds가 우선)
# WEARLY_AI_TIMEOUT=PT60S
# true면 공급자 options.baseUrl(API 주소 바꾸기)을 허용한다. 키가 다른 주소로 갈 수 있어 운영에서는 false
# WEARLY_AI_ALLOW_BASE_URL=false
