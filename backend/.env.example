# backend/.env로 복사해서 쓴다 (.env는 git에 올리지 않는다)
# 값을 비워 두면 application.yml의 기본값을 쓴다.

# --- AI 공급자 키 ---------------------------------------------------------
# 어떤 공급자를 어떤 순서로 쓸지는 관리자 화면(AI 공급자, tb_ai_provider)에서 정한다.
# 각 공급자 행의 "키 환경변수 이름"(기본 아래 세 개)에 값이 있어야 그 공급자를 쓸 수 있다.
# 키가 하나도 없어도 서버는 시작한다 (시작 로그 WARN, 사진 분석은 502 AI_UNAVAILABLE).
# 키 없이 목업으로 띄우려면 ./gradlew bootRunMock (WEARLY_AI_PROVIDER=mock)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- 관리자 계정 ----------------------------------------------------------
# 둘 다 있으면 시작할 때 이 계정을 만들거나 기존 계정을 ADMIN으로 올린다.
# 비밀번호는 8~64자, 영문과 숫자를 모두 포함 (기존 계정의 비밀번호·이름은 바꾸지 않는다)
WEARLY_ADMIN_EMAIL=
WEARLY_ADMIN_PASSWORD=
# WEARLY_ADMIN_NAME=관리자

# JWT 서명 키 (HS256, 32바이트 이상). 운영(prod 프로필)에서는 필수
WEARLY_JWT_SECRET=

# 선택 항목
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/wearly
# SPRING_DATASOURCE_USERNAME=wearly
# SPRING_DATASOURCE_PASSWORD=wearly
# SERVER_PORT=8080
# WEARLY_ACCESS_TTL=PT30M
# WEARLY_REFRESH_TTL=P30D
# AI 실행 방식: db(기본, 관리자 화면의 공급자 설정) | mock. 여기에 mock을 적으면 bootRun도 목업이 되니 보통은 두지 않는다
# WEARLY_AI_PROVIDER=db
# WEARLY_AI_DAILY_LIMIT=10
# 공급자 옵션 timeoutSeconds가 없을 때의 호출 제한 시간
# WEARLY_AI_TIMEOUT=PT60S
# 공급자 옵션 baseUrl(테스트 서버·프록시)을 받을지. 기본 false (키가 공식 API 주소로만 나간다)
# WEARLY_AI_ALLOW_BASE_URL=false
