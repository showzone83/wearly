# backend/.env로 복사해서 쓴다 (.env는 git에 올리지 않는다)
# 값을 비워 두면 application.yml의 기본값을 쓴다.

# Claude API 키. 있으면 WEARLY_AI_PROVIDER=auto일 때 Claude로 분석한다
ANTHROPIC_API_KEY=

# JWT 서명 키 (HS256, 32바이트 이상). 운영(prod 프로필)에서는 필수
WEARLY_JWT_SECRET=

# 선택 항목
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/wearly
# SPRING_DATASOURCE_USERNAME=wearly
# SPRING_DATASOURCE_PASSWORD=wearly
# SERVER_PORT=8080
# WEARLY_ACCESS_TTL=PT30M
# WEARLY_REFRESH_TTL=P30D
# WEARLY_AI_PROVIDER=auto
# WEARLY_AI_MODEL=claude-opus-5-5
# WEARLY_AI_DAILY_LIMIT=10
