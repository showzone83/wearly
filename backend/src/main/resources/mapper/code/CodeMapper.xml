<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 코드 테이블 읽기: 캐시 적재, 버전. 사용 수는 옷장·프로필 컨텍스트가 CodeUsageSource로 답한다 (H1) -->
<mapper namespace="app.wearly.code.adapter.out.persistence.mybatis.mapper.CodeMapper">

    <resultMap id="codeRow" type="app.wearly.code.adapter.out.persistence.mybatis.dto.CodeRowDto">
        <result property="groupCode" column="group_code"/>
        <result property="code" column="code"/>
        <result property="label" column="label"/>
        <result property="parentCode" column="parent_code"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="active" column="active"/>
        <result property="attrs" column="attrs" typeHandler="app.wearly.common.mybatis.JsonbMapTypeHandler"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>


    <select id="findGroups" resultType="app.wearly.code.adapter.out.persistence.mybatis.dto.CodeGroupRowDto">
        SELECT group_code, name, description, sort_order
          FROM tb_code_group
         ORDER BY sort_order, group_code
    </select>

    <select id="findCodes" resultMap="codeRow">
        SELECT group_code, code, label, parent_code, sort_order, active, attrs, updated_at
          FROM tb_code
         ORDER BY group_code, sort_order, code_id
    </select>

    <!-- 코드가 바뀌면(추가·수정·삭제) 달라지는 문자열. 예: 2026-10-17T05:00:00.000Z#102 -->
    <select id="version" resultType="string">
        SELECT coalesce(to_char(max(updated_at) AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'), 'empty')
               || '#' || count(*)
          FROM tb_code
    </select>
</mapper>
