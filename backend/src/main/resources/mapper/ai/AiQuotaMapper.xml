<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- AI 일일 사용량 집계 (기능별 성공만: 사진 분석 ITEM_ANALYZE · 코디 추천 OUTFIT_RECOMMEND, 관리자 시험 분석 제외). 날짜 경계(Asia/Seoul 자정)는 서비스에서 계산해 넘긴다 -->
<mapper namespace="app.wearly.ai.adapter.out.persistence.mybatis.mapper.AiQuotaMapper">


    <select id="countSuccess" resultType="long">
        SELECT count(*)
          FROM tb_ai_analysis_log
         WHERE user_id = #{userId}
           AND status = 'SUCCESS'
           AND feature = #{feature}
           AND created_at &gt;= #{from}
           AND created_at &lt; #{to}
    </select>

    <select id="countReservations" resultType="long">
        SELECT count(*)
          FROM tb_ai_usage_reservation
         WHERE user_id = #{userId}
           AND feature = #{feature}
           AND created_at &gt;= #{since}
    </select>

    <!-- 같은 회원·기능의 한도 확인을 한 줄로 세운다 (M7). 트랜잭션이 끝나면 풀린다 -->
    <select id="lockQuota" resultType="int">
        SELECT 1 FROM (SELECT pg_advisory_xact_lock(hashtextextended('ai-quota:' || #{userId} || ':' || #{feature}, 0))) l
    </select>

</mapper>
