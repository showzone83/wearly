<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- AI 일일 사용량 집계 (사진 분석 성공만, 관리자 시험 분석 제외). 날짜 경계(Asia/Seoul 자정)는 서비스에서 계산해 넘긴다 -->
<mapper namespace="app.wearly.ai.AiUsageMapper">

    <resultMap id="aiLogRow" type="app.wearly.ai.AiLogRow">
        <id property="id" column="ai_analysis_log_id"/>
        <result property="feature" column="feature"/>
        <result property="provider" column="provider"/>
        <result property="model" column="model"/>
        <result property="status" column="status"/>
        <result property="errorCode" column="error_code"/>
        <result property="imageSha256" column="image_sha256"/>
        <result property="result" column="result" typeHandler="app.wearly.common.mybatis.JsonbMapTypeHandler"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="countSuccess" resultType="long">
        SELECT count(*)
          FROM tb_ai_analysis_log
         WHERE user_id = #{userId}
           AND status = 'SUCCESS'
           AND feature = 'ITEM_ANALYZE'
           AND created_at &gt;= #{from}
           AND created_at &lt; #{to}
    </select>

    <select id="findRecent" resultMap="aiLogRow">
        SELECT ai_analysis_log_id, feature, provider, model, status, error_code, image_sha256, result, created_at
          FROM tb_ai_analysis_log
         WHERE user_id = #{userId}
         ORDER BY created_at DESC, ai_analysis_log_id DESC
         LIMIT #{limit}
    </select>
</mapper>
